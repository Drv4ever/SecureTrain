# Groq API Configuration (optional; keep real keys in deployment environment settings)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
JWT_SECRET=replace_with_a_long_random_secret
COMPANY_NAME=Your Company
VITE_SHOW_DEMO_CREDENTIALS=false

# Local SQLite path (used when DATABASE_URL is unset)
DATABASE_PATH=trainer.db

# For hosted PostgreSQL, set DATABASE_URL instead (Render Blueprint wires this automatically).
# DATABASE_URL=postgresql://user:password@host:5432/database
