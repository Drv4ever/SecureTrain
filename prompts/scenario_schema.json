{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["tactic", "difficulty", "sender_name", "sender_email", "subject", "body", "indicators", "hook"],
  "properties": {
    "tactic": { "type": "string", "enum": ["urgency", "authority", "invoice", "credential"] },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "sender_name": { "type": "string", "minLength": 2, "maxLength": 60 },
    "sender_email": { "type": "string", "minLength": 5 },
    "subject": { "type": "string", "minLength": 5, "maxLength": 120 },
    "body": { "type": "string", "minLength": 60 },
    "indicators": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 3 } },
    "hook": { "type": "string", "minLength": 10 }
  }
}